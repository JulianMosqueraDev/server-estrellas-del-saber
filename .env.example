NODE_ENV=development
HOST=127.0.0.1
PORT=3001
LOG_LEVEL=info
DATABASE_URL=postgresql://estrellas_local:change_me_local_only@localhost:5432/estrellas_saber
DATABASE_POOL_MAX=5
DATABASE_CONNECTION_TIMEOUT_MS=2000

# Local-only placeholder. Generate a unique 32-byte base64url secret for deployed environments.
AUTH_JWT_SECRET=local-development-only-change-this-placeholder-secret-before-deployment
# Optional transition key: keep the previous production key here for at most one access-token TTL.
AUTH_JWT_PREVIOUS_SECRET=
AUTH_JWT_ISSUER=http://localhost:3001
AUTH_JWT_AUDIENCE=estrellas-del-saber-web
AUTH_ACCESS_TOKEN_TTL_SECONDS=600
AUTH_REFRESH_TOKEN_TTL_DAYS=30
AUTH_LOGIN_RATE_LIMIT_MAX=10
AUTH_REFRESH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
WEB_ORIGIN=http://localhost:3000
AUTH_COOKIE_SAME_SITE=lax

POSTGRES_DB=estrellas_saber
POSTGRES_USER=estrellas_local
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_PORT=5432
